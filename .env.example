# Copy this file to ".env" (which git ignores) and edit it. Everything here is optional.

# Which address the app listens on, on the host.
#   127.0.0.1  only this machine can reach it (default, safest)
#   0.0.0.0    every device on your network can reach it. Polaris has no
#              login, so only do this if something in front of it (a reverse
#              proxy, VPN or tunnel) handles authentication.
BIND_ADDR=127.0.0.1

# Which port on the host.
HOST_PORT=8091

# Which release to run (for example 2.0.0). Leave it out for the latest.
# POLARIS_VERSION=latest

# The domain names you reach Polaris by, separated by commas. A request
# addressed to any other name is refused, with a page saying which line to
# write here.
#
# You never need to list localhost, an address in numbers (192.168.1.20),
# a name without a dot (nas, or the name another container calls this one
# by) or a name ending in .local, .home.arpa or .internal: those always
# work, because no other website can use them.
#
# Why: another website can point a name of its own at this machine ("DNS
# rebinding"). To your browser that site and Polaris are then one site, so
# its pages could read your stories and change them. Polaris can only tell
# by the name it was called by.
#
# ALLOWED_HOSTS=* answers to any name, as Polaris did before 3.2. Only for
# when something in front of Polaris checks the name itself.
# ALLOWED_HOSTS=polaris.example.com

# Polaris keeps a copy of each story on the days it changes (the last 7,
# then one a week for 4 weeks), beside the story on the data volume. "off"
# turns that off.
# AUTO_BACKUPS=off
