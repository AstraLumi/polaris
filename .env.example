# Copy this file to ".env" (which git ignores) and edit it. Everything here is optional.

# Which address the app listens on, on the host.
#   127.0.0.1  only this machine can reach it (default, safest)
#   0.0.0.0    every device on your network can reach it. Polaris has no
#              login, so only do this if something in front of it (a reverse
#              proxy, VPN or tunnel) handles authentication.
BIND_ADDR=127.0.0.1

# Which port on the host.
HOST_PORT=8091

# Which release to run (for example 2.0.0). Leave it out for the latest.
# POLARIS_VERSION=latest

# The names Polaris answers to, separated by commas: every name you type
# to reach it (a domain, the server's network name or address, the name
# another container calls it by). This machine's own names (localhost,
# 127.0.0.1) always work. Leave it out and Polaris answers to any name.
#
# Why set it: another website can point a name of its own at this machine
# ("DNS rebinding"). To your browser that site and Polaris are then one
# site, so its pages could read your stories and change them. Polaris can
# only tell by the name it was called by. It matters when Polaris can be
# reached from a computer you browse the web on.
# ALLOWED_HOSTS=polaris.example.com

# Polaris keeps a copy of each story on the days it changes (the last 7,
# then one a week for 4 weeks), beside the story on the data volume. "off"
# turns that off.
# AUTO_BACKUPS=off
