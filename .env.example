# Copy this file to ".env" (which git ignores) and edit it. Everything here is optional.

# Which address the app listens on, on the host.
#   127.0.0.1  only this machine can reach it (default, safest)
#   0.0.0.0    every device on your network can reach it. Polaris has no
#              login, so only do this if something in front of it (a reverse
#              proxy, VPN or tunnel) handles authentication.
BIND_ADDR=127.0.0.1

# Which port on the host.
HOST_PORT=8091
